# Supply-chain hardening. Applies to every npm install / npm ci in this project, CI included.

# Don't run packages' install/postinstall scripts. Nothing we depend on needs them
# (native deps ship prebuilt binaries); they're the usual vehicle for malicious packages.
# `npm run <script>` for our own scripts is unaffected.
ignore-scripts=true

# Only resolve versions that have been on the registry for a week. Hijacked releases are
# normally spotted and pulled within days, so this keeps them out of `npm install`/`npm update`.
min-release-age=3

# Never fetch dependencies straight from git repositories.
allow-git=none
